# ==========================================
# OYUN PORTALI ÇEVRE DEĞİŞKENLERİ (.env)
# ==========================================

# 1. Ortak Supabase Bilgileri (Her iki oyun tek veritabanını paylaşıyorsa):
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Özel Supabase Bilgileri (Oyunların veritabanları ayrı ise):
# VETO için:
# VITE_VETO_SUPABASE_URL=https://veto-project.supabase.co
# VITE_VETO_SUPABASE_ANON_KEY=your-veto-anon-key

# HARFBAZ için:
# VITE_HARFBAZ_SUPABASE_URL=https://harfbaz-project.supabase.co
# VITE_HARFBAZ_SUPABASE_ANON_KEY=your-harfbaz-anon-key
